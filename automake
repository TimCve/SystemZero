#!/bin/bash
set -euo pipefail
cd -- "$(dirname -- "$0")"
make all
if [ -t 0 ]; then
    read -r -p "Write any more files? [y/n] " answer
    if [[ "$answer" == y ]]; then
        read -r -p "Input file names separated by spaces: " -a files
        for file in "${files[@]}"; do
            ./ESFS_raw_write --replace os-image.bin "${file##*/}" "$file"
        done
    fi
fi
if command -v VBoxManage >/dev/null 2>&1; then
    make convert_vmdk
fi
printf 'QEMU disk image ready: os-image.bin. Run make run.\n'
