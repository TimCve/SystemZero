#!/bin/bash
set -euo pipefail
cd -- "$(dirname -- "$0")"
make all
args=(-m 64M -drive format=raw,file=os-image.bin,index=0)
case "${1:-}" in
    gtk|sdl) args+=(-display "$1");;
    "") ;;
    *) printf 'Usage: %s [gtk|sdl]\n' "$0" >&2; exit 1;;
esac
for index in 1 2 3; do
    image="virtual_disks/drive_$index.bin"
    if [ ! -f "$image" ]; then
        printf 'Missing %s; run ./create_virtual_disks first.\n' "$image" >&2
        exit 1
    fi
    args+=(-drive "format=raw,file=$image,index=$index")
done
exec qemu-system-i386 "${args[@]}"
