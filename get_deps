#!/bin/bash
# Print compiler-derived header prerequisites; compilation is handled by make.
set -euo pipefail
if [ "$#" -ne 1 ]; then
    printf 'Usage: %s <source_file.c>\n' "$0" >&2
    exit 1
fi
root=$(cd -- "$(dirname -- "$0")" && pwd)
source="$root/external_programs/${1##*/}"
gcc -m32 -ffreestanding -MM "$source"
