#!/bin/bash
set -euo pipefail
cd -- "$(dirname -- "$0")"
make ESFS_raw_write
mkdir -p virtual_disks
for index in 1 2 3; do
    image="virtual_disks/drive_$index.bin"
    if [ -e "$image" ]; then
        printf 'Keeping existing disk: %s\n' "$image"
        continue
    fi
    truncate -s 100M "$image"
    ./ESFS_raw_write --format "$image"
    printf 'Created ESFS disk: %s\n' "$image"
done
